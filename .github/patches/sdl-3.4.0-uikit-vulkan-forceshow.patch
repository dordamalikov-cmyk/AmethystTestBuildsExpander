--- a/src/video/uikit/SDL_uikitvulkan.m
+++ b/src/video/uikit/SDL_uikitvulkan.m
@@ -245,6 +245,41 @@ bool UIKit_Vulkan_CreateSurface(SDL_VideoDevice *_this,
         }
     }

+    /* [Amethyst] The SDL window is created HIDDEN (SDL_WINDOW_HIDDEN is the SDL3
+     * create default) and is only shown when the game calls SDL_ShowWindow after
+     * presenting its first frame — which never happens when the first Metal
+     * submit is rejected (VK_ERROR_DEVICE_LOST "Insufficient Permission (to submit
+     * GPU work from background)") because the CAMetalLayer sits in a hidden window.
+     * The Vulkan surface is now created and its layer is attached to the window's
+     * view, so force-show the window: the layer moves into the visible hierarchy
+     * and Metal stops rejecting submissions. SDL_ShowWindow is a no-op if already
+     * shown and is safe from any thread (our uikit-window-mainthread patch bounces
+     * the driver's ShowWindow to the main queue). */
+    SDL_ShowWindow(window);
+    /* [Amethyst diag] confirm the force-show ran (fprintf -> app log). */
+    fprintf(stderr, "[SDL ForceShow] window shown after Vulkan surface creation: '%s'\n",
+            window->title);
+    fflush(stderr);
+
+    /* [Amethyst] Keep the screen awake for the render session. SDL3's
+     * UIKit_SuspendScreenSaver writes app.idleTimerDisabled =
+     * (suspend_screensaver != false) during SDL_Init, which can clobber the app's
+     * own idleTimerDisabled=YES back to NO; with the idle timer armed the screen
+     * auto-locks ~30-60s into the black pre-first-frame gap, the app backgrounds,
+     * and MoltenVK rejects the first vkQueueSubmit with
+     * kIOGPUCommandBufferCallbackErrorBackgroundExecutionNotPermitted
+     * (VK_ERROR_DEVICE_LOST). Disable the screensaver now, after the window is up;
+     * setting SDL's suspend_screensaver flag keeps idleTimerDisabled=YES even if
+     * the hook runs again later. */
+    UIApplication *uiApp = [UIApplication sharedApplication];
+    fprintf(stderr, "[SDL ForceShow] before: isIdleTimerDisabled=%d applicationState=%ld\n",
+            uiApp.isIdleTimerDisabled, (long)uiApp.applicationState);
+    fflush(stderr);
+    SDL_DisableScreenSaver();
+    fprintf(stderr, "[SDL ForceShow] after: isIdleTimerDisabled=%d\n",
+            uiApp.isIdleTimerDisabled);
+    fflush(stderr);
+
